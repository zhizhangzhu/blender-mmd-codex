  "experiments": [
    {
      "id": "E1",
      "title": "左右分别设计的脸影阈值图",
      "status": "hypothesis_not_implemented",
      "toggle": "exp_face_threshold_map",
      "off_behavior": "回到现有 SDF 输入",
      "blender52_stock_eevee": "principle_feasible_not_tested",
      "new_dependencies_required": false,
      "changes": "只替换现有 SDF 形状输入；独立验证头轴、实际主灯、左右角度和纹理阈值约定。",
      "test": "两角色分别检查灯方位 -90/-45/0/45/90 度及转头、张嘴连续段。",
      "reject_if": ["过零左右翻转或闪跳", "孤立鼻口黑岛", "需逐帧归一化或恢复高脸亮度下限才能成立"],
      "guardrail": "保留平整脸部 Diffuse 探针和真实遮挡，不新增第二次脸影。",
      "sources": ["mooa_shadow", "sdf_threshold_author", "blender52_passes"]
    },
    {
      "id": "E2",
      "title": "一簇刘海的法线包络",
      "status": "hypothesis_not_implemented",
      "toggle": "exp_hair_normal_envelope",
      "off_behavior": "关闭诊断副本的单个法线传递修改器，保留原法线",
      "blender52_stock_eevee": "builtin_capability_documented_rig_and_outline_not_tested",
      "new_dependencies_required": false,
      "changes": "一簇紧随头部的刘海以顶点组混合法线包络，先比较 0/0.25/0.5；发带固定。",
      "test": "五个灯方位和该簇摆动段；先确认 Diffuse 分支读取实际改后法线。",
      "reject_if": ["变形后法线包络滑动", "发根接缝", "消除侧面体积", "影响原 PMX 描边"],
      "guardrail": "不改变权重、物理、脸或毛领；法线不冒充切线高光。",
      "sources": ["blender52_data_transfer", "blender_normal_edit", "mooa_hair"]
    },
    {
      "id": "E3",
      "title": "职责明确的三个控制图",
      "status": "hypothesis_not_implemented",
      "toggle": "exp_control_maps",
      "off_behavior": "回到原阈值、原 AO 强度与无遮罩裁除的发带",
      "blender52_stock_eevee": "ordinary_nodes_feasible_semantics_not_tested",
      "new_dependencies_required": false,
      "controls": [
        {"name": "form_bias", "color_space": "Non-Color", "neutral": 0.5, "formula": "D'=clamp(D+k*(2*M-1),0,1)", "trial_k": 0.05, "disable": "k=0"},
        {"name": "ao_strength", "color_space": "Non-Color", "neutral": 1, "operation": "调节现有一次 AO 的强度", "disable": "旁路回原 AO 强度"},
        {"name": "hair_highlight_allow", "color_space": "Non-Color", "neutral": 1, "operation": "仅裁除现有发带或高光", "disable": "恒为 1"}
      ],
      "test": "单项依次开启，区分边界移动、AO 强度和高光许可，再检查动态 UV 接缝。",
      "reject_if": ["阈值偏移错误地推亮真实投影", "重复乘 AO", "未知原贴图按名字自动复用"],
      "guardrail": "若当前综合 Diffuse 不能分离形体与真实遮挡，form_bias 只能先在无外部遮挡诊断副本试验。",
      "sources": ["unity_uts_basic", "mooa_shadow", "mooa_hair", "blender52_passes"]
    }
  ],
